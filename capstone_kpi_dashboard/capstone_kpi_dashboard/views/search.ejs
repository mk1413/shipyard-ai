<%- include('partials/header', { title: '블록 목록·검색', active: 'search' }) %>
<h1>블록 목록과 검색</h1>
<p class="lead">검색어를 비우면 전체 블록-공정을 보여 줍니다. 호선 번호, 블록 ID, 선종, 공정으로 찾을 수 있습니다.</p>

<form class="search-form" method="get" action="/search" role="search">
  <input name="q" value="<%= q %>" placeholder="예: 대조립, 2401, 운반선, 2401-B01" aria-label="블록 검색">
  <button type="submit">검색</button>
</form>

<% if (mode === 'list') { %>
  <p class="muted">전체 블록-공정 <strong><%= total %></strong>건 · 페이지 <%= page %> / <%= pageCount %></p>
<% } else { %>
  <p class="muted">검색 결과 <strong><%= total %></strong>건 (최대 100건)</p>
<% } %>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>블록</th><th>호선</th><th>선종</th><th>공정</th>
        <th>계획 착수</th><th>계획 종료</th><th>실제 착수</th><th>실제 종료</th>
        <th class="num">진척률</th><th>상태</th><th class="num">지연일수</th><th>지연 사유</th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(function (r) { %>
        <tr class="search-row">
          <td><%= r.block_id %></td><td><%= r.ship_no %></td><td><%= r.ship_type %></td>
          <td><%= r.process %></td>
          <td><%= r.planned_start %></td><td><%= r.planned_end %></td>
          <td><%= r.actual_start || '-' %></td><td><%= r.actual_end || '-' %></td>
          <td class="num"><%= Number(r.progress_pct).toFixed(1) %>%</td>
          <td><span class="badge <%= r.status.indexOf('지연') >= 0 ? 'crit' : (r.status.indexOf('완료') === 0 ? 'good' : 'warn') %>"><%= r.status %></span></td>
          <td class="num <%= r.delay_days > 0 ? 'delay' : '' %>"><%= r.delay_days %></td>
          <td><%= r.delay_reason || '-' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<% if (mode === 'list' && pageCount > 1) { %>
  <div class="pager">
    <% if (page > 1) { %><a href="/search?page=<%= page - 1 %>">◀ 이전</a><% } %>
    <span class="muted"><%= page %> / <%= pageCount %></span>
    <% if (page < pageCount) { %><a href="/search?page=<%= page + 1 %>">다음 ▶</a><% } %>
  </div>
<% } %>

<%- include('partials/footer') %>

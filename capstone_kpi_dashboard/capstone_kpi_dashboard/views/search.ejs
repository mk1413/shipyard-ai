<%- include('partials/header', { title: '블록 목록·검색', active: 'search' }) %>
<h1>블록 목록과 검색</h1>
<p class="lead">검색어를 비우면 전체 블록-공정을 보여 줍니다. 상태와 호선으로 좁힐 수 있고, 호선 번호, 블록 ID, 선종, 공정으로 검색할 수 있습니다.</p>

<form class="search-form" method="get" action="/search" role="search">
  <input type="hidden" name="status" value="<%= filters.status %>">
  <input type="hidden" name="ship" value="<%= filters.ship %>">
  <input type="hidden" name="asOf" value="<%= asOfCustom ? asOf : '' %>">
  <input name="q" value="<%= q %>" placeholder="예: 대조립, 2401, 운반선, 2401-B01" aria-label="블록 검색">
  <button type="submit">검색</button>
</form>

<div class="filter-bar" aria-label="상태 필터">
  <span class="filter-label">상태</span>
  <% statusOptions.forEach(function (o) { %>
    <a class="chip<%= filters.status === o.key ? ' on' : '' %>" href="<%= links.status[o.key] %>"><%= o.label %></a>
  <% }) %>
</div>
<div class="filter-bar" aria-label="호선 필터">
  <span class="filter-label">호선</span>
  <% ['all'].concat(ships).forEach(function (s) { %>
    <a class="chip<%= filters.ship === s ? ' on' : '' %>" href="<%= links.ship[s] %>"><%= s === 'all' ? '전체' : s + '호선' %></a>
  <% }) %>
</div>

<form class="asof" method="get" action="/search" aria-label="기준일 선택">
  <input type="hidden" name="q" value="<%= q %>">
  <input type="hidden" name="status" value="<%= filters.status %>">
  <input type="hidden" name="ship" value="<%= filters.ship %>">
  <label>기준일 <input type="date" name="asOf" value="<%= asOf %>"></label>
  <button type="submit">적용</button>
  <% if (asOfCustom) { %><a class="asof-reset" href="/search?q=<%= encodeURIComponent(q) %>&status=<%= filters.status %>&ship=<%= filters.ship %>">오늘로</a><% } %>
  <span class="muted">상태(지연·진행·완료·대기)는 이 기준일로 판정합니다.</span>
</form>

<% if (mode === 'list') { %>
  <p class="muted">
    <% if (filters.status !== 'all' || filters.ship !== 'all') { %>
      필터 결과 <strong><%= total %></strong>건 (전체 <%= allTotal %>건 중)
    <% } else { %>
      전체 블록-공정 <strong><%= total %></strong>건
    <% } %>
    · 페이지 <%= page %> / <%= pageCount %>
  </p>
<% } else { %>
  <p class="muted">검색 결과 <strong><%= total %></strong>건 (최대 100건)</p>
<% } %>

<% if (rows.length === 0) { %>
  <div class="card empty">조건에 맞는 블록이 없습니다. 상태나 호선 필터를 바꿔 보세요.</div>
<% } else { %>
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>블록</th><th>호선</th><th>선종</th><th>공정</th>
        <th>계획 착수</th><th>계획 종료</th><th>실제 착수</th><th>실제 종료</th>
        <th class="num">진척률</th><th class="num">계획 MH</th><th class="num">실적 MH</th><th class="num">MH 효율</th><th>상태</th><th class="num">지연일수</th><th>지연 사유</th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(function (r) { %>
        <tr class="search-row">
          <td><%= r.block_id %></td><td><%= r.ship_no %></td><td><%= r.ship_type %></td>
          <td><%= r.process %></td>
          <td><%= r.planned_start %></td><td><%= r.planned_end %></td>
          <td><%= r.actual_start || '-' %></td><td><%= r.actual_end || '-' %></td>
          <td class="num"><%= Number(r.progress_pct).toFixed(1) %>%</td>
          <td class="num"><%= Number(r.planned_mh).toFixed(1) %></td>
          <td class="num"><%= Number(r.actual_mh) > 0 ? Number(r.actual_mh).toFixed(1) : '-' %></td>
          <td class="num"><%= Number(r.actual_mh) > 0 ? (Number(r.planned_mh) / Number(r.actual_mh) * 100).toFixed(1) + '%' : '-' %></td>
          <td><span class="badge <%= r.status.indexOf('지연') >= 0 ? 'crit' : (r.status.indexOf('완료') === 0 ? 'good' : 'warn') %>"><%= r.status %></span></td>
          <td class="num <%= r.delay_days > 0 ? 'delay' : '' %>"><%= r.delay_days %></td>
          <td><%= r.delay_reason || '-' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<% if (mode === 'list' && pageCount > 1) { %>
  <div class="pager">
    <% if (page > 1) { %><a href="<%= links.page(page - 1) %>">◀ 이전</a><% } %>
    <span class="muted"><%= page %> / <%= pageCount %></span>
    <% if (page < pageCount) { %><a href="<%= links.page(page + 1) %>">다음 ▶</a><% } %>
  </div>
<% } %>

<%- include('partials/footer') %>

<%- include('partials/header', { title: '공정 진척도', active: 'progress' }) %>
<%
  const fmt = (v) => (v == null ? '-' : v.toFixed(1) + '%');
  const doneRate = summary.total ? (summary.done / summary.total) * 100 : null;
  const mhLevel = summary.mhEff == null ? '' : (summary.mhEff >= 95 ? 'good' : (summary.mhEff >= 92 ? 'warn' : 'crit'));
%>
<div class="page-head">
  <div>
    <h1>공정 진척도</h1>
    <p class="lead">호선별, 공정별 블록 진척 현황을 한눈에 봅니다. 진척률은 블록-공정 행의 단순 평균입니다.</p>
  </div>
  <span class="stamp">기준일 2026-10-31 · 가상 데이터</span>
</div>

<section class="kpi-grid" aria-label="핵심 지표">
  <div class="card kpi <%= summary.overallLevel %>">
    <div class="label">전체 평균 진척률</div>
    <div class="value"><%= fmt(summary.overall) %></div>
    <div class="sub">블록-공정 <%= summary.total %>건 기준</div>
  </div>
  <div class="card kpi">
    <div class="label">완료율</div>
    <div class="value"><%= fmt(doneRate) %></div>
    <div class="sub">완료 <%= summary.done %> / 전체 <%= summary.total %></div>
  </div>
  <div class="card kpi <%= summary.delayed > 0 ? 'crit' : 'good' %>">
    <div class="label">지연 블록-공정</div>
    <div class="value"><%= summary.delayed %><small>건</small></div>
    <div class="sub">계획 종료일을 넘긴 항목</div>
  </div>
  <div class="card kpi <%= mhLevel %>">
    <div class="label">맨아워 효율</div>
    <div class="value"><%= fmt(summary.mhEff) %></div>
    <div class="sub">계획 MH ÷ 실적 MH · 목표 95%</div>
  </div>
  <div class="card kpi <%= failureCount > 0 ? 'warn' : 'good' %>">
    <div class="label">설비 고장</div>
    <div class="value"><%= failureCount %><small>건</small></div>
    <div class="sub">정지 합계 <%= failureMinutes %>분<% if (topFailure) { %> · 최다 <%= topFailure.equipment_id %>(<%= topFailure.n %>건)<% } %></div>
  </div>
  <div class="card kpi <%= worst ? worst.level : '' %>">
    <div class="label">진척 가장 낮은 호선</div>
    <div class="value"><%= worst ? worst.ship_no + '호선' : '-' %></div>
    <div class="sub"><%= worst ? '평균 ' + fmt(worst.avg) + ' · 지연 ' + worst.delayed + '건' : '데이터 없음' %></div>
  </div>
</section>

<section class="grid-2 wide-left" style="margin-top:18px">
  <div class="card">
    <h3>호선별 전체 진척률</h3>
    <p class="hint">막대 끝 숫자는 호선 평균, 점선은 목표 90%입니다.</p>
    <%- shipBarsHtml %>
    <div class="legend">
      <span><i style="background:var(--good)"></i>90% 이상</span>
      <span><i style="background:var(--warn)"></i>70~90%</span>
      <span><i style="background:var(--crit)"></i>70% 미만</span>
    </div>
  </div>
  <div class="card">
    <h3>공정별 호선 진척률</h3>
    <p class="hint">공정마다 호선 4개의 평균 진척률을 비교합니다.</p>
    <%- processHtml %>
    <div class="legend">
      <% summary.ships.forEach(function (s, i) { %>
        <span><i style="background:var(--s<%= i %>)"></i><%= s.ship_no %>호선</span>
      <% }) %>
    </div>
  </div>
</section>

<h2>바로가기</h2>
<section class="tiles">
  <a class="tile" href="/search">
    <div class="ico">🧱</div>
    <strong>블록 목록·검색</strong>
    <span>블록-공정 <%= summary.total %>건을 날짜, 상태, 지연 사유와 함께 봅니다.</span>
    <span class="go">이동 →</span>
  </a>
  <a class="tile" href="/failures">
    <div class="ico">🛠</div>
    <strong>설비 고장 이력</strong>
    <span>설비별 고장 건수와 정지 시간, 원인을 확인합니다.</span>
    <span class="go">이동 →</span>
  </a>
  <a class="tile" href="/">
    <div class="ico">📊</div>
    <strong>공정 진척도 (현재 화면)</strong>
    <span>호선 × 공정 히트맵으로 병목 공정을 찾습니다.</span>
    <span class="go">위로 보기 ↑</span>
  </a>
</section>

<h2>호선 × 공정 히트맵</h2>
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>호선</th><th>선종</th>
        <% summary.processes.forEach(function (p) { %><th class="num"><%= p %></th><% }) %>
        <th class="num">전체</th><th class="num">지연</th>
      </tr>
    </thead>
    <tbody>
      <% summary.ships.forEach(function (s) { %>
        <tr>
          <td><strong><%= s.ship_no %></strong></td>
          <td><%= s.ship_type %></td>
          <% summary.processes.forEach(function (p) { const c = s.cells[p]; %>
            <td class="cell <%= c.level %>">
              <%= fmt(c.avg) %>
              <small><%= c.count %>블록</small>
            </td>
          <% }) %>
          <td class="cell <%= s.level %>"><%= fmt(s.avg) %></td>
          <td class="num <%= s.delayed > 0 ? 'delay' : '' %>"><%= s.delayed %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<p class="note">
  색 기준: <span class="badge good">90% 이상</span> <span class="badge warn">70~90%</span> <span class="badge crit">70% 미만</span> <span class="badge none">데이터 없음</span>
</p>

<%- include('partials/footer') %>

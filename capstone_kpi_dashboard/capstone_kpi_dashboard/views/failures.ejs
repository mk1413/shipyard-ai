<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>설비 고장 이력 · 조선소 생산 KPI 대시보드</title>
  <style>
    body { margin: 0; font-family: "Malgun Gothic", "Apple SD Gothic Neo", sans-serif; background: #f8fafc; color: #0f172a; }
    main { max-width: 1000px; margin: 0 auto; padding: 16px; }
    nav a { margin-right: 12px; }
    .table-wrap { overflow-x: auto; }
    table { border-collapse: collapse; width: 100%; font-size: 0.9rem; background: #fff; margin-bottom: 24px; }
    th, td { border-bottom: 1px solid #e2e8f0; padding: 6px; text-align: left; white-space: nowrap; }
    .muted { color: #64748b; }
  </style>
</head>
<body>
<main>
  <nav>
    <a href="/search">블록 목록·검색</a>
    <a href="/failures">설비 고장 이력</a>
  </nav>
  <h1>🛠 설비 고장 이력</h1>
  <p class="muted">가상 데이터입니다. 고장 건수 <%= rows.length %>건</p>

  <h2>설비별 요약 (정지 시간 많은 순)</h2>
  <div class="table-wrap">
  <table>
    <thead><tr><th>설비</th><th>설비 종류</th><th>고장 건수</th><th>정지 시간 합계(분)</th></tr></thead>
    <tbody>
      <% byEquipment.forEach(function (e) { %>
        <tr><td><%= e.equipment_id %></td><td><%= e.equipment_type %></td><td><%= e.count %></td><td><%= e.total_min %></td></tr>
      <% }) %>
    </tbody>
  </table>
  </div>

  <h2>고장 목록 (최근 순)</h2>
  <div class="table-wrap">
  <table>
    <thead><tr><th>고장 번호</th><th>날짜</th><th>설비</th><th>설비 종류</th><th>공정</th><th>정지 시간(분)</th><th>원인</th></tr></thead>
    <tbody>
      <% rows.forEach(function (r) { %>
        <tr>
          <td><%= r.failure_id %></td><td><%= r.date %></td><td><%= r.equipment_id %></td>
          <td><%= r.equipment_type %></td><td><%= r.process %></td><td><%= r.duration_min %></td><td><%= r.cause %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
</main>
</body>
</html>

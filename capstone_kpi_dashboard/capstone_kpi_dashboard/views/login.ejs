<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>로그인 · 조선소 생산 KPI 대시보드</title>
  <link rel="stylesheet" href="/assets/app.css">
</head>
<body>
<header class="topbar">
  <div class="topbar-inner">
    <span class="brand">🚢 조선소 생산 KPI</span>
  </div>
</header>
<main class="auth">
  <h1>로그인</h1>
  <p class="lead">사번과 이름은 등록된 명단과 대조합니다.</p>
  <% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %>
  <form method="post" action="/login" autocomplete="off" class="card">
    <label>사번 <input name="employee_no" required inputmode="numeric"></label>
    <label>이름 <input name="name" required></label>
    <button type="submit">로그인</button>
  </form>
</main>
</body>
</html>
